# Microservices live here as regular tracked files so their code is kept
# in this repository. We only ignore per-service noise.

# node_modules, build artifacts and env files (also covered by root .gitignore)
*/node_modules/
node_modules/
*/dist/
*/build/
*/.env
*/.env.local
*/.env.development
*/.env.production

# Postgres/session artifacts
*.tsbuildinfo

# Keep configuration files
!config.json
!setup.sh
!README.md
!docker-compose.yml
!Dockerfile.template
