<%- include('partials/head') %>
<div class="container">
  <h1>Create an account</h1>
  <p class="muted">Registration & Onboarding</p>
  <% if (error) { %><div class="err"><%= error %></div><% } %>
  <form method="POST" action="/register" id="registerForm">
    <label>Full name</label>
    <input type="text" name="name" required />

    <label>Email</label>
    <input type="email" name="email" required />

    <label>Password</label>
    <input type="password" name="password" required minlength="6" />

    <label>Profile photo (optional)</label>
    <div class="avatar-crop" id="signupAvatarCrop">
      <input type="file" class="avatar-file-input" accept="image/*" />
      <div class="avatar-crop-wrap" style="display:none">
        <canvas class="avatar-crop-canvas" width="180" height="180"></canvas>
        <label class="crop-label">Zoom</label>
        <input type="range" class="avatar-zoom-range" min="1" max="3" step="0.01" value="1" />
        <p class="muted small">Drag the photo to reposition it.</p>
      </div>
      <input type="hidden" name="avatar_url" class="avatar-hidden-input" />
    </div>

    <div class="checkbox-row">
      <input type="checkbox" name="tos" id="tos" value="on" />
      <label for="tos" class="inline-label">I agree to the <a class="link" href="#">Terms of Service</a> and <a class="link" href="#">Privacy Policy</a></label>
    </div>

    <button type="submit">Sign up</button>
  </form>
  <p class="muted" style="margin-top:16px">Already have an account? <a class="link" href="/login">Log in</a></p>
</div>
<script src="/js/avatar-crop.js"></script>
<script>initAvatarCrop('signupAvatarCrop');</script>
</body>
</html>
