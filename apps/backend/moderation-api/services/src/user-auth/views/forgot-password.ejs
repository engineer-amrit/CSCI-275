<%- include('partials/head') %>
<div class="container">
  <h1>Forgot password</h1>
  <p class="muted">Password Management</p>
  <% if (message) { %><div class="msg"><%= message %></div><% } %>
  <% if (resetLink) { %>
    <p class="muted">Simulated email link (in production this would be emailed):</p>
    <p><a class="link" href="<%= resetLink %>"><%= resetLink %></a></p>
  <% } %>
  <form method="POST" action="/forgot-password">
    <label>Email</label>
    <input type="email" name="email" required />
    <button type="submit">Send reset link</button>
  </form>
  <p class="muted" style="margin-top:16px"><a class="link" href="/login">Back to login</a></p>
</div>
</body>
</html>
