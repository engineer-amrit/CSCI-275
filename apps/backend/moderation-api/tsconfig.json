{
  "extends": "@config/ts/node",
  "compilerOptions": {
    "types": ["vitest/globals", "node", "multer"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@/types": ["./src/types/index.ts"],
      "@test/*": ["./test/*"]
    }
  }
}
